@startuml UC09_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Tình nguyện viên |
start
:Chọn mục "Lịch sử cứu hộ"\ntrên màn hình chính;

|#ffffff| Ứng dụng |
:Gửi yêu cầu tải\nlịch sử và thống kê;

|#ffffff| Máy chủ |
:Trả về dữ liệu thống kê\nvà danh sách 100 ca gần nhất;

|#ffffff| Ứng dụng |
if (Có lịch sử\ncứu hộ nào?) then ([Không])
  :**[1a]** Chưa có lịch sử;
  :Hiển thị thống kê toàn 0\nvà danh sách trống;
  kill
else ([Có])
endif

:Hiển thị bảng thống kê tổng hợp:\nTổng số ca đã tham gia\nSố ca hoàn thành / đã từ bỏ\nTổng quãng đường đã di chuyển (km)\nThời gian phản hồi trung bình;

:Hiển thị danh sách 100 ca gần nhất:\nThời gian, mô tả ngắn\nKết quả (hoàn thành / đã từ bỏ)\nKhoảng cách ban đầu;

|#ffffff| Tình nguyện viên |
:Nhấn vào 1 ca\nđể xem chi tiết;

|#ffffff| Ứng dụng |
:Hiển thị chi tiết ca:\nThời gian nhận ca\nThời gian hoàn thành;

|#ffffff| Tình nguyện viên |
:Xem xong, đóng chi tiết\nvề danh sách;

stop

@enduml
