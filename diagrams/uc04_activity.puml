@startuml UC04_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Nạn nhân |
start

if (Nạn nhân chọn\nkết thúc ca?) then ([1a] Hủy ca)
  |#ffffff| Ứng dụng |
  :Hiển thị xác nhận\n"Bạn có chắc muốn hủy ca SOS?";
  |#ffffff| Nạn nhân |
  if (Xác nhận hủy?) then ([Không])
    :Quay lại màn hình theo dõi;
    stop
  else ([Có])
  endif
  |#ffffff| Máy chủ |
  :**[1a]** Đánh dấu ca đã hủy\nGiải phóng TNV (nếu có);
  :Xóa toàn bộ tin nhắn trong ca;
  :Gửi thông báo các bên\nca đã kết thúc;
  |#ffffff| Ứng dụng |
  :Hiển thị\n"Ca SOS đã được hủy";
  stop
else ([Đã được giúp đỡ])
endif

|#ffffff| Nạn nhân |
:Nhấn "Tôi đã được giúp đỡ";

|#ffffff| Ứng dụng |
:Hiển thị xác nhận\n"Bạn xác nhận đã được cứu hộ?";

|#ffffff| Nạn nhân |
if (Xác nhận\nhoàn thành?) then ([Không])
  :Quay lại màn hình theo dõi;
  stop
else ([Có])
endif

|#ffffff| Máy chủ |
:Đánh dấu ca hoàn thành\nGhi nhận thời điểm kết thúc;
:Cập nhật TNV về\ntrạng thái sẵn sàng nhận ca mới;
:Xóa toàn bộ tin nhắn trong ca;
:Gửi thông báo ca đã hoàn thành\nđến các bên liên quan;

|#ffffff| Ứng dụng |
:Hiển thị\n"Ca cứu hộ đã hoàn thành";
stop

@enduml
