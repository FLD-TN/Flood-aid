@startuml UC07_LocDsSOS

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor Black
skinparam SequenceArrowThickness 1
skinparam ParticipantBorderColor Black
skinparam ParticipantBackgroundColor White
skinparam ParticipantFontColor Black
skinparam ParticipantFontSize 15
skinparam ParticipantBorderThickness 1
skinparam LifeLineBorderColor Black
skinparam LifeLineBorderThickness 1
skinparam SequenceGroupBorderColor Black
skinparam SequenceGroupBackgroundColor White
skinparam SequenceGroupBodyBackgroundColor White
skinparam SequenceGroupFontSize 14
skinparam SequenceDividerBorderColor Black
skinparam SequenceDividerBackgroundColor White
skinparam SequenceDividerFontSize 14
skinparam SequenceDividerFontStyle bold
skinparam SequenceActivationBorderColor Black
skinparam SequenceActivationBackgroundColor White
skinparam NoteBackgroundColor White
skinparam NoteBorderColor Black
hide footbox

participant "Tình nguyện viên" as TNV
participant "Ứng dụng" as Screen
participant "Máy chủ" as ListCtrl
participant "Cơ sở dữ liệu" as SOSCase

TNV -> Screen : Mở màn hình "Danh sách ca SOS"
Screen -> ListCtrl : Tải danh sách ca SOS đang chờ cứu hộ
ListCtrl -> SOSCase : Truy vấn ca SOS đang ở trạng thái chờ

alt 1a : Không có ca SOS nào đang chờ
    ListCtrl --> Screen : Danh sách rỗng
    Screen --> TNV : "Hiện không có ca SOS nào đang chờ cứu hộ"

else Có ca SOS đang chờ
    ListCtrl --> Screen : Danh sách ca SOS
    Screen --> TNV : Hiển thị danh sách — mô tả ngắn, mức độ khẩn cấp (1–5),\nkhoảng cách và nhãn phân loại

    TNV -> Screen : Nhấn lọc, chọn tiêu chí, nhấn "Áp dụng"
    Screen -> ListCtrl : Lọc danh sách theo tiêu chí đã chọn
    ListCtrl -> SOSCase : Lọc theo mức độ khẩn cấp, khoảng cách, nhãn

    alt 3a : Không có ca nào khớp bộ lọc
        ListCtrl --> Screen : Kết quả rỗng
        Screen --> TNV : "Không có ca SOS nào phù hợp"

        alt 2a : TNV đặt lại bộ lọc
            TNV -> Screen : Nhấn "Đặt lại bộ lọc"
            Screen -> ListCtrl : Xóa tiêu chí, tải lại toàn bộ danh sách
            ListCtrl --> Screen : Danh sách đầy đủ
            Screen --> TNV : Hiển thị lại toàn bộ danh sách ca SOS
        end

    else Có ca khớp bộ lọc
        ListCtrl --> Screen : Danh sách kết quả
        Screen --> TNV : Hiển thị kết quả sau khi lọc

        TNV -> Screen : Chọn tiêu chí sắp xếp\n(Gần trước / Xa trước / Mới trước / Cũ trước)
        Screen --> TNV : Hiển thị danh sách đã sắp xếp

        TNV -> Screen : Nhấn vào một ca để xem chi tiết
        Screen --> TNV : Chi tiết ca — mô tả đầy đủ, vị trí bản đồ,\nmức độ khẩn cấp, nhãn phân loại, thời gian gửi
    end
end

@enduml
