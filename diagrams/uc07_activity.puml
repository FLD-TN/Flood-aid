@startuml UC07_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Tình nguyện viên |
start
:Mở màn hình "Danh sách ca SOS";

|#ffffff| Ứng dụng |
:Tải danh sách ca SOS\nchưa được xử lý;

|#ffffff| Máy chủ |
if (Có ca SOS nào\ntrong hệ thống?) then ([Không])
  :**[1a]** Không có ca SOS;
  :Hiển thị "Hiện không có ca SOS\nnào đang chờ cứu hộ";
  kill
else ([Có])
endif

:Trả về danh sách ca SOS\nđang chờ cứu hộ;

|#ffffff| Ứng dụng |
:Hiển thị danh sách ca SOS:\nMô tả ngắn, mức độ khẩn cấp (1–5)\nKhoảng cách, nhãn phân loại;

|#ffffff| Tình nguyện viên |
:Nhấn biểu tượng Lọc;

|#ffffff| Ứng dụng |
:Hiển thị bảng lọc:\nMức độ khẩn cấp (1–5)\nKhoảng cách tối đa\nNhãn phân loại;

|#ffffff| Tình nguyện viên |
:Chọn một hoặc nhiều\ntiêu chí lọc;
:Nhấn "Áp dụng";

|#ffffff| Máy chủ |
:Lọc danh sách theo\ncác tiêu chí đã chọn;

if (Có ca nào\nkhớp bộ lọc?) then ([Không])
  :**[3a]** Không có ca SOS nào phù hợp;
  |#ffffff| Ứng dụng |
  :Hiển thị "Không có ca SOS nào phù hợp";
  |#ffffff| Tình nguyện viên |
  if (Nhấn "Đặt lại\nbộ lọc"?) then ([Có])
    :**[2a]** Đặt lại bộ lọc;
    |#ffffff| Ứng dụng |
    :Xóa tiêu chí lọc\nHiển thị lại toàn bộ danh sách;
    detach
  else ([Không])
    |#ffffff| Tình nguyện viên |
    stop
  endif
else ([Có])
endif

:Trả kết quả lọc về ứng dụng;

|#ffffff| Ứng dụng |
:Hiển thị danh sách\nkết quả sau lọc;

|#ffffff| Tình nguyện viên |
:Chọn tiêu chí sắp xếp:\nGần trước / Xa trước /\nMới trước / Cũ trước;

|#ffffff| Ứng dụng |
:Sắp xếp lại danh sách\ntheo tiêu chí đã chọn;

|#ffffff| Tình nguyện viên |
:Nhấn vào 1 ca\nđể xem chi tiết;

|#ffffff| Ứng dụng |
:Hiển thị chi tiết ca:\nMô tả đầy đủ, vị trí trên bản đồ\nMức độ khẩn cấp, nhãn phân loại\nThời gian gửi;

stop

@enduml
