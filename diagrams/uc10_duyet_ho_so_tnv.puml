@startuml UC10_DuyetHoSoTNV

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor Black
skinparam SequenceArrowThickness 1
skinparam ParticipantBorderColor Black
skinparam ParticipantBackgroundColor White
skinparam ParticipantFontColor Black
skinparam ParticipantFontSize 15
skinparam ParticipantBorderThickness 1
skinparam LifeLineBorderColor Black
skinparam LifeLineBorderThickness 1
skinparam SequenceGroupBorderColor Black
skinparam SequenceGroupBackgroundColor White
skinparam SequenceGroupBodyBackgroundColor White
skinparam SequenceGroupFontSize 14
skinparam SequenceDividerBorderColor Black
skinparam SequenceDividerBackgroundColor White
skinparam SequenceDividerFontSize 14
skinparam SequenceDividerFontStyle bold
skinparam SequenceActivationBorderColor Black
skinparam SequenceActivationBackgroundColor White
skinparam NoteBackgroundColor White
skinparam NoteBorderColor Black
hide footbox

participant "Admin" as Admin
participant "Trình duyệt" as Browser
participant "Máy chủ" as Server
participant "Cơ sở dữ liệu" as DB

Admin -> Browser : Mở trang "Quản lý Tình nguyện viên"
Browser -> Server : Tải danh sách TNV đang chờ phê duyệt
Server -> DB : Truy vấn hồ sơ trạng thái "Chờ phê duyệt"
Server --> Browser : Danh sách TNV chờ duyệt
Browser --> Admin : Hiển thị danh sách — họ tên, số điện thoại, trạng thái CCCD

Admin -> Browser : Chọn một hồ sơ để xem chi tiết
Browser --> Admin : Hiển thị hồ sơ — họ tên, số điện thoại, trạng thái eKYC

alt Admin từ chối hồ sơ
    Admin -> Browser : Nhấn "Từ chối"
    Browser -> Server : Gửi yêu cầu từ chối
    Server -> DB : Cập nhật trạng thái thành "Từ chối"
    Server --> Browser : Thành công
    Browser --> Admin : Cập nhật trạng thái hồ sơ trong danh sách

else Admin phê duyệt hồ sơ
    Admin -> Browser : Nhấn "Phê duyệt"
    Browser -> Server : Gửi yêu cầu phê duyệt
    Server -> DB : Cập nhật trạng thái thành "Đã phê duyệt"
    Server --> Browser : Thành công
    Browser --> Admin : Cập nhật trạng thái hồ sơ trong danh sách
end

@enduml
