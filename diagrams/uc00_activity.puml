@startuml UC00_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Admin |
start
:Mở trang Dashboard FloodAid;

|#ffffff| Ứng dụng |
:Hiển thị form đăng nhập\n(ô nhập email và mật khẩu);

|#ffffff| Admin |
:Nhập email và mật khẩu\nNhấn "Đăng nhập";

|#ffffff| Máy chủ |
if (Tài khoản đang\nbị tạm khóa?) then ([Có])
  :**[3b]** Vượt quá số lần thử cho phép\nHiển thị: "Tài khoản đang bị tạm khóa\nVui lòng thử lại sau";
  kill
else ([Không])
endif

if (Email và mật khẩu\nhợp lệ?) then ([Không])
  :**[3a]** Thông tin đăng nhập sai\nHiển thị: "Email hoặc mật khẩu không đúng"\n(không tiết lộ trường nào sai);
  detach
else ([Có])
endif

:Xác thực thành công\nTạo phiên làm việc cho Admin;

|#ffffff| Ứng dụng |
:Chuyển Admin vào\ntrang chính Dashboard;
stop

@enduml
