@startuml UC03_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Nạn nhân |
start
:Mở màn hình theo dõi ca cứu hộ;

|#ffffff| Ứng dụng |
:Hiển thị bản đồ vị trí nạn nhân\nvà trạng thái "Đang tìm tình nguyện viên...";

|#ffffff| Máy chủ |
:Chờ tình nguyện viên nhận ca;

if (Có TNV nhận ca\ntrong 15 phút?) then ([Không])
  :**[1a]** Thông báo Admin và hiển thị\n"Chưa tìm được TNV"; hệ thống tiếp tục chờ;
else ([Có])
endif

|#ffffff| Máy chủ |
:Ghi nhận TNV đã nhận ca\nvà cập nhật trạng thái ca;

if (Kết nối ổn\nđịnh?) then ([Không])
  :**[2a]** Chuyển chế độ dự phòng\ncập nhật vị trí TNV định kỳ;
else ([Có])
  :Cập nhật vị trí TNV liên tục\ntheo thời gian thực;
endif

|#ffffff| Ứng dụng |
:Hiển thị vị trí TNV và khoảng cách còn lại\ncho tới khi TNV đến nơi;

stop

@enduml
