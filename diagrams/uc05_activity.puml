@startuml UC05_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Nạn nhân |
start
:Chọn mục "Lịch sử"\ntrên menu;

|#ffffff| Ứng dụng |
:Gửi yêu cầu lấy\nlịch sử SOS;

|#ffffff| Máy chủ |
:Lấy danh sách lịch sử SOS\ncủa người dùng;

if (Đã có lịch sử\nca SOS nào?) then ([Không])
  :**[1a]** Chưa có ca SOS nào;
  |#ffffff| Ứng dụng |
  :Hiển thị thông báo\n"Bạn chưa gửi yêu cầu SOS nào";
  kill
else ([Có])
endif

|#ffffff| Máy chủ |
:Trả về danh sách\nlịch sử SOS;

|#ffffff| Ứng dụng |
:Hiển thị danh sách ca SOS\n(mới nhất trước)\nThời gian gửi, mô tả tóm tắt\nTrạng thái, mức độ khẩn cấp\nNhãn phân loại, TNV phụ trách (nếu có);

|#ffffff| Nạn nhân |
:Xem danh sách hoặc thoát;
stop

@enduml
