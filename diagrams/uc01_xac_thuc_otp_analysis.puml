@startuml UC01_XacThucOTP_Analysis

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor Black
skinparam SequenceArrowThickness 1
skinparam ParticipantBorderColor Black
skinparam ParticipantBackgroundColor White
skinparam ParticipantFontColor Black
skinparam ParticipantFontSize 15
skinparam ParticipantBorderThickness 1
skinparam LifeLineBorderColor Black
skinparam LifeLineBorderThickness 1
skinparam SequenceGroupBorderColor Black
skinparam SequenceGroupBackgroundColor White
skinparam SequenceGroupBodyBackgroundColor White
skinparam SequenceGroupFontSize 14
skinparam SequenceDividerBorderColor Black
skinparam SequenceDividerBackgroundColor White
skinparam SequenceDividerFontSize 14
skinparam SequenceDividerFontStyle bold
skinparam SequenceActivationBorderColor Black
skinparam SequenceActivationBackgroundColor White
skinparam SequenceReferenceBorderColor Black
skinparam SequenceReferenceBackgroundColor White
skinparam SequenceReferenceFontSize 11
skinparam NoteBackgroundColor White
skinparam NoteBorderColor Black
hide footbox

participant "Người dùng" as User
participant "Ứng dụng" as Screen
participant "Máy chủ" as Auth
participant "Cơ sở dữ liệu" as Account

User -> Screen : Mở ứng dụng FloodAid
Screen --> User : Hiển thị màn hình chọn vai trò

User -> Screen : Chọn vai trò, nhập số điện thoại, nhấn "Gửi mã OTP"

alt 2a : Số điện thoại không đúng định dạng
    Screen --> User : Báo lỗi định dạng tại ô nhập, yêu cầu nhập lại

else Số điện thoại hợp lệ
    Screen -> Auth : Yêu cầu gửi OTP
    Auth --> User : Gửi mã OTP qua SMS (hết hạn sau 60 giây)

    loop 4a, 4b : Tối đa 3 lần nhập OTP

        opt 3a : Người dùng nhấn "Gửi lại OTP" (tối đa 3 lần, cách >= 60 giây)
            User -> Screen : Nhấn "Gửi lại OTP"
            Screen -> Auth : Yêu cầu gửi lại OTP
            Auth --> User : Gửi mã OTP mới qua SMS
        end

        User -> Screen : Nhập mã OTP
        Screen -> Auth : Xác minh mã OTP

        alt 4a : OTP không đúng
            Auth --> Screen : "Mã OTP không đúng" (còn X lần thử)
        else 4b : OTP đã hết hạn
            Auth --> Screen : "Mã OTP đã hết hạn"
        else OTP đúng
            Auth --> Screen : Xác thực thành công
        end

        break 4a : Quá 3 lần sai — tạm khóa 5 phút
            Screen --> User : "Tạm khóa 5 phút. Vui lòng thử lại sau."
        end

    end

    Auth -> Account : Tra cứu tài khoản theo số điện thoại và vai trò

    alt Vai trò là Nạn nhân
        Auth --> Screen : Cho phép truy cập
        Screen --> User : Vào màn hình chính Nạn nhân

    else Vai trò là TNV — hồ sơ đã được phê duyệt
        Auth --> Screen : Cho phép truy cập
        Screen --> User : Vào màn hình chính Tình nguyện viên

    else Vai trò là TNV — hồ sơ đang chờ phê duyệt
        Auth --> Screen : Tài khoản chờ phê duyệt
        Screen --> User : "Hồ sơ đang chờ Admin phê duyệt"

    else Vai trò là TNV — lần đầu đăng ký
        Auth --> Screen : Chưa có tài khoản TNV
        ref over Screen, Auth : UC06 — Đăng ký TNV với eKYC
    end
end

@enduml
