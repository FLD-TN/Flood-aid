@startuml UseCase_Overview

scale 0.85
skinparam shadowing false
skinparam backgroundColor #ffffff
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActorBorderColor #222222
skinparam ActorBackgroundColor #eeeeee
skinparam ActorFontSize 14
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #334466
skinparam UsecaseBackgroundColor #ffffff
skinparam UsecaseFontSize 12

skinparam ArrowColor #444444
skinparam ArrowFontSize 10
skinparam ArrowFontColor #333333

skinparam RectangleBorderColor #111111
skinparam RectangleBorderThickness 3
skinparam RectangleFontSize 16
skinparam RectangleFontStyle bold
skinparam RectangleBackgroundColor #f9f9f9

skinparam PackageBorderColor #666666
skinparam PackageBorderThickness 1.2
skinparam PackageFontSize 11
skinparam PackageFontStyle bold

top to bottom direction

' ── Actors xếp ngang trên ──
actor "Nạn nhân" as NN
actor "Tình nguyện viên (TNV)" as TNV
actor "Admin" as Admin

NN    -[hidden]right- TNV
TNV   -[hidden]right- Admin

rectangle "Hệ thống FloodAid" {

  package "Dùng chung" #e8f4e8 {
    usecase "UC01  Xác thực OTP" as UC01
    usecase "UC11  Liên lạc trong ca" as UC11
  }

  package "Chức năng Nạn nhân" #dde8f8 {
    usecase "UC02  Gửi yêu cầu SOS" as UC02
    usecase "UC03  Theo dõi ca cứu hộ" as UC03
    usecase "UC04  Đóng / Hủy ca SOS" as UC04
    usecase "UC05  Xem lịch sử SOS" as UC05
  }

  package "Chức năng TNV" #fff3e0 {
    usecase "UC06  Đăng ký TNV với eKYC" as UC06
    usecase "UC07  Lọc danh sách ca SOS" as UC07
    usecase "UC08  Nhận ca cứu hộ" as UC08
    usecase "UC09  Xem lịch sử cứu hộ" as UC09
    usecase "UC12  Theo dõi hành trình cứu hộ" as UC12
  }

  package "Quản trị" #f3e5f5 {
    usecase "UC00  Đăng nhập Admin" as UC00
    usecase "UC10  Duyệt hồ sơ TNV" as UC10
  }

  ' ── layout hints: ngang ──
  UC01  -[hidden]right- UC02
  UC02  -[hidden]right- UC06
  UC06  -[hidden]right- UC00

  UC11  -[hidden]right- UC03
  UC03  -[hidden]right- UC07
  UC07  -[hidden]right- UC10

  UC04  -[hidden]right- UC08
  UC05  -[hidden]right- UC09
}

' ── Nạn nhân ──
NN -down-> UC01
NN -down-> UC02
NN -down-> UC03
NN -down-> UC04
NN -down-> UC05
NN -down-> UC11

' ── TNV ──
TNV -down-> UC01
TNV -down-> UC06
TNV -down-> UC07
TNV -down-> UC08
TNV -down-> UC09
TNV -down-> UC11
TNV -down-> UC12

' ── Admin ──
Admin -down-> UC00
Admin -down-> UC10

' ── «extend» ──
UC11  ..> UC03  : «extend»
UC11  ..> UC12  : «extend»

@enduml
