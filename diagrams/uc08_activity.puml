@startuml UC08_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Tình nguyện viên |
start
:Nhấn "Tôi sẽ đi cứu";

|#ffffff| Ứng dụng |
:Gửi yêu cầu nhận ca\nlên máy chủ;

|#ffffff| Máy chủ |
if (TNV đang có\nnhiệm vụ chưa hoàn thành?) then ([Có])
  :**[3b]** TNV đang bận\nThông báo: "Bạn đang có nhiệm vụ chưa kết thúc";
  kill
else ([Không])
endif

|#ffffff| Máy chủ |
if (Ca SOS còn\nở trạng thái chờ?) then ([Không])
  :**[3a]** Ca đã được TNV khác nhận\nThông báo: "Ca này đã có người nhận", quay về danh sách;
  kill
else ([Có])
endif

|#ffffff| Máy chủ |
:Ghi nhận phân công cứu hộ\nLưu khoảng cách ban đầu từ TNV đến nạn nhân;
:Cập nhật ca thành "Đang cứu hộ"\nCập nhật TNV thành "Đang thực hiện nhiệm vụ";
:Gửi thông báo đến nạn nhân\n"Đã có TNV đang đến"\nkèm số điện thoại TNV;
:Cung cấp số điện thoại nạn nhân\ncho TNV;

|#ffffff| Ứng dụng |
:Chuyển TNV sang\nmàn hình theo dõi cứu hộ;

stop

@enduml
