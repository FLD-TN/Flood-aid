@startuml Hinh4_1_QuyTrinhSOS

scale 0.95
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam rectangle {
  BorderColor black
  BackgroundColor White
  FontColor black
  FontSize 13
}
skinparam ArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 11

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 6

<style>
rectangle {
  RoundCorner 8
  LineThickness 1.2
}
</style>

rectangle "**THIẾT BỊ DI ĐỘNG**" as MOBILE #f7f7f7 {
  rectangle "Giọng nói\ncủa nạn nhân" as A
  rectangle "Nhận dạng giọng nói\n(speech-to-text)" as B
  rectangle "Chuẩn hóa phương ngữ\nmiền Trung" as C
}

rectangle "**MÁY CHỦ**" as SERVER #f7f7f7 {
  rectangle "Phân loại mức độ khẩn cấp\n(dò từ khóa + mô hình ngôn ngữ)" as D
  rectangle "Lưu ca SOS kèm tọa độ\n(cơ sở dữ liệu không gian)" as E
  rectangle "Phát sóng đến\ntình nguyện viên" as F
}

A -down-> B : âm thanh
B -down-> C : văn bản thô\n(còn lẫn phương ngữ)
C -down-> D : văn bản đã chuẩn hóa\n+ văn bản gốc (đối chiếu)
D -down-> E : mức khẩn cấp 1–5,\nnhãn, mô tả ngắn
E -down-> F : ca ở trạng thái "chờ"

note right of C
  Người dùng gõ chữ thay vì nói
  thì bỏ qua hai bước trên,
  vào thẳng bước phân loại.
end note

@enduml
