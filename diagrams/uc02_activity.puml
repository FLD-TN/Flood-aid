@startuml UC02_Activity

scale 0.88
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 10
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 10
}
document {
  Padding 10
}
</style>

|#ffffff| Nạn nhân |
start
:Nhấn nút SOS\ntrên màn hình chính;

|#ffffff| Ứng dụng |
:Hiển thị form SOS\n(ô mô tả, nút ghi âm, bản đồ vị trí);

|#ffffff| Nạn nhân |
if (Cách nhập\nmô tả?) then ([Giọng nói])
  :**[2a]** Nhấn giữ nút mic\nGhi âm tình trạng;
  |#ffffff| Ứng dụng |
  :Chuyển giọng nói thành văn bản\nChuẩn hóa phương ngữ miền Trung\nĐiền vào ô mô tả;
else ([Gõ chữ])
  :Nhập mô tả tình trạng\nvào ô văn bản;
endif

|#ffffff| Ứng dụng |
if (GPS xác định\nđược vị trí?) then ([Có])
  :Lấy vị trí GPS tự động\nHiển thị trên bản đồ;
else ([Không])
  :**[2b]** Thông báo không\nxác định được GPS;
  |#ffffff| Nạn nhân |
  :Kéo thả ghim vị trí\nthủ công trên bản đồ;
  |#ffffff| Ứng dụng |
  :Ghi nhận vị trí\ndo người dùng chọn;
endif

|#ffffff| Ứng dụng |
:Hiển thị form SOS đầy đủ\nsẵn sàng gửi;

|#ffffff| Nạn nhân |
:Nhấn "Gửi SOS";

|#ffffff| Ứng dụng |
if (Có kết nối\nmạng?) then ([Không])
  :**[3a]** Thông báo mất kết nối\nNhấn thử lại khi có mạng;
  detach
else ([Có])
endif

:Gửi yêu cầu SOS lên máy chủ;

|#ffffff| Máy chủ |
:Nhận và kiểm tra yêu cầu SOS;

if (Đang có ca SOS\nchưa kết thúc?) then ([Có])
  :**[4a]** Từ chối yêu cầu;
  |#ffffff| Ứng dụng |
  :Thông báo "Bạn đang có\nca SOS chưa kết thúc";
  kill
else ([Không])
endif

|#ffffff| Máy chủ |
:Phân tích mô tả bằng AI\n(mức độ khẩn cấp 1–5, nhãn phân loại,\ntóm tắt 1 dòng; tối đa 3 giây);

if (AI phản hồi\nkịp thời gian?) then ([Có])
  :Sử dụng kết quả phân tích AI;
else ([Không])
  :**[5a]** Dùng kết quả\nphân tích dự phòng;
endif

|#ffffff| Máy chủ |
:Lưu ca SOS\ntrạng thái "Đang chờ";
:Lấy danh sách TNV đang sẵn sàng\nvà bật nhận thông báo;
:Gửi thông báo đến\ncác tình nguyện viên;

|#ffffff| Ứng dụng |
:Chuyển sang màn hình\ntheo dõi ca cứu hộ (UC03);
stop

@enduml
