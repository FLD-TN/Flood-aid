@startuml UC01_Activity

scale 0.75
skinparam shadowing false
skinparam backgroundColor #f0f0f0
skinparam headerBackgroundColor #f0f0f0
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam ActivityBorderColor black
skinparam ActivityBackgroundColor White
skinparam ActivityFontColor black
skinparam ActivityFontSize 13

skinparam ActivityDiamondBorderColor black
skinparam ActivityDiamondBackgroundColor White
skinparam ActivityDiamondFontColor black
skinparam ActivityDiamondFontSize 14

skinparam ActivityArrowColor black
skinparam ArrowFontColor black
skinparam ArrowFontSize 12

skinparam ActivityStartColor Black
skinparam ActivityEndColor Black

skinparam conditionStyle diamond

skinparam DiagramBorderColor black
skinparam DiagramBorderThickness 8
skinparam PartitionBorderColor black
skinparam PartitionBorderThickness 3

<style>
diamond {
  RoundCorner 0
  LineThickness 1.5
  Padding 5
}
activity {
  RoundCorner 8
}
swimlane {
  BorderThickness 3
  BorderColor black
  TitleBorderThickness 4
  TitleBorderColor black
  TitleBackgroundColor #e8e8e8
  TitleFontSize 24
  BackgroundColor #ffffff
  Padding 4
}
document {
  Padding 4
}
</style>

|#ffffff| Người dùng |
start
:Mở ứng dụng FloodAid;
:Chọn vai trò\n(Nạn nhân / Tình nguyện viên);
:Nhập số điện thoại;

|#ffffff| Ứng dụng |
if (SĐT đúng\nđịnh dạng?) then ([Không])
  :**[2a]** Báo lỗi định dạng\nCho phép nhập lại;
  detach
else ([Có])
endif

:Gửi yêu cầu mã OTP;

|#ffffff| Máy chủ |
:Gửi mã OTP\nqua tin nhắn SMS;

|#ffffff| Người dùng |
if (Nhận được OTP?) then ([Không])
  :**[3a]** Nhấn "Gửi lại OTP"\nHệ thống gửi mã mới\n(tối đa 3 lần, cách 60 giây);
  detach
else ([Có])
endif

repeat
  :Nhập mã OTP;

  |#ffffff| Ứng dụng |
  if (Đã vượt\n3 lần sai?) then ([Có])
    :**[4a]** Khóa chức năng 5 phút;
    kill
  else ([Chưa])
  endif

  |#ffffff| Người dùng |
repeat while (OTP hợp lệ?) is ([Không:\n[4a] sai — nhập lại\n[4b] hết hạn — [3a] gửi lại]) not ([Có])

:OTP được xác nhận;

|#ffffff| Ứng dụng |
:Gửi yêu cầu xác minh\nđăng nhập lên máy chủ;

|#ffffff| Máy chủ |
:Nhận và kiểm tra\ntính hợp lệ của yêu cầu;

if (Yêu cầu\nhợp lệ?) then ([Không])
  :Từ chối yêu cầu;
  kill
else ([Có])
endif

:Tra cứu tài khoản theo số điện thoại và vai trò,\nxác định trạng thái để điều hướng;

if (Vai trò?) then ([Nạn nhân])
  |#ffffff| Ứng dụng |
  :Lưu phiên đăng nhập\nVào màn hình chính Nạn nhân;
  stop
else ([Tình nguyện viên])
  if (Trạng thái\ntài khoản?) then ([Đã được duyệt])
    |#ffffff| Ứng dụng |
    :Lưu phiên đăng nhập\nVào màn hình chính TNV;
    stop
  else ([Chưa được duyệt])
    if (Đã từng\nđăng ký?) then ([Chờ phê duyệt])
      |#ffffff| Ứng dụng |
      :Hiển thị "Hồ sơ đang\nchờ Admin phê duyệt";
      stop
    else ([Lần đầu đăng ký])
      |#ffffff| Ứng dụng |
      :Chuyển sang màn hình\nđăng ký eKYC (UC06);
      stop
    endif
  endif
endif

@enduml
