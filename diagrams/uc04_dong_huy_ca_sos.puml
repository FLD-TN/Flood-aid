@startuml UC04_DongHuyCaSOS

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor Black
skinparam SequenceArrowThickness 1
skinparam ParticipantBorderColor Black
skinparam ParticipantBackgroundColor White
skinparam ParticipantFontColor Black
skinparam ParticipantFontSize 15
skinparam ParticipantBorderThickness 1
skinparam LifeLineBorderColor Black
skinparam LifeLineBorderThickness 1
skinparam SequenceGroupBorderColor Black
skinparam SequenceGroupBackgroundColor White
skinparam SequenceGroupBodyBackgroundColor White
skinparam SequenceGroupFontSize 14
skinparam SequenceDividerBorderColor Black
skinparam SequenceDividerBackgroundColor White
skinparam SequenceDividerFontSize 14
skinparam SequenceDividerFontStyle bold
skinparam SequenceActivationBorderColor Black
skinparam SequenceActivationBackgroundColor White
skinparam NoteBackgroundColor White
skinparam NoteBorderColor Black
hide footbox

participant "Nạn nhân" as Victim
participant "Ứng dụng" as Screen
participant "Máy chủ" as CaseCtrl
participant "Cơ sở dữ liệu" as SOSCase

alt Nạn nhân đã được giúp đỡ
    Victim -> Screen : Nhấn "Tôi đã được giúp đỡ"
    Screen --> Victim : "Bạn xác nhận đã được cứu hộ?"

    alt Không xác nhận
        Victim -> Screen : Nhấn "Không"
        Screen --> Victim : Quay lại màn hình theo dõi

    else Xác nhận đã được cứu hộ
        Victim -> Screen : Nhấn "Có, tôi đã được cứu hộ"
        Screen -> CaseCtrl : Gửi yêu cầu đóng ca
        CaseCtrl -> SOSCase : Đánh dấu ca hoàn thành, ghi thời điểm kết thúc\nCập nhật TNV về sẵn sàng, xóa tin nhắn, thông báo các bên
        CaseCtrl --> Screen : Đóng ca thành công
        Screen --> Victim : "Ca cứu hộ đã hoàn thành!\nCảm ơn bạn đã sử dụng FloodAid."
    end

else 1a : Nạn nhân muốn hủy ca
    Victim -> Screen : Nhấn "Hủy ca"
    Screen --> Victim : "Bạn có chắc muốn hủy ca SOS?"

    alt Không xác nhận
        Victim -> Screen : Nhấn "Không"
        Screen --> Victim : Quay lại màn hình theo dõi

    else Xác nhận hủy
        Victim -> Screen : Nhấn "Có, hủy ca"
        Screen -> CaseCtrl : Gửi yêu cầu hủy ca
        CaseCtrl -> SOSCase : Đánh dấu ca đã hủy\nGiải phóng TNV (nếu có), xóa tin nhắn, thông báo các bên
        CaseCtrl --> Screen : Hủy ca thành công
        Screen --> Victim : "Ca SOS đã được hủy"
    end
end

@enduml
