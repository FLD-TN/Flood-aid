# FloodAid Backend Environment Variables
NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://postgres:password@localhost:5432/floodaid

# Phone Hash Salt
PHONE_HASH_SALT=floodaid_secret_salt_change_me

# Gemini AI API (Module 1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_MS=3000

# Firebase Admin SDK (FCM + Auth)
FIREBASE_ADMIN_SDK=./firebase-service-account.json

# FPT eKYC API (Module 3 - TNV verification)
FPT_EKYC_API_KEY=your_fpt_ekyc_key_here

# Geo-Dispatch Config
INITIAL_RADIUS_KM=3
EXTENDED_RADIUS_KM=10
SKILL_MATCH_WAIT_MS=120000
BROADCAST_WAIT_MS=300000
ORPHAN_ALERT_MS=900000

# Phone Encryption Key (AES-256-GCM) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPT_KEY=your_random_hex_key_here
